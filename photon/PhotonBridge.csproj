<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>PhotonBridge</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>0618</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="DirectLink.cs" />
    <Compile Include="../vendor/photon/PhotonRealtimeApi/*.cs" />
    <Reference Include="PhotonClient"><HintPath>../vendor/photon/PhotonLibs/Release/netstandard2.0/PhotonClient.dll</HintPath></Reference>
  </ItemGroup>
</Project>
